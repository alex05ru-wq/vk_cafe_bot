# Скопируйте этот файл в .env и впишите свои данные
# Ключ доступа сообщества: Управление → Работа с API → Ключи доступа
VK_TOKEN=vk1.a.ваш_ключ
# ID сообщества — только цифры (из адреса vk.com/club123456789)
GROUP_ID=
# ID вашей страницы ВКонтакте — сюда приходят заказы.
# Важно: сначала напишите сообществу любое сообщение, иначе оно не сможет вам писать.
ADMIN_ID=
